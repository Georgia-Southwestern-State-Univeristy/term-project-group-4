option_settings:
  aws:elasticbeanstalk:application:environment:
    # Production deployment environment variables (Elastic Beanstalk).
    NODE_ENV: production
    PORT: "8080"
    FRONTEND_URL: "https://spcg.zentrofi.com"
    # Set these in each environment via EB console/CLI to real values.
    GOOGLE_CLIENT_ID: "CHANGE_ME"
    GOOGLE_CLIENT_SECRET: "CHANGE_ME"
    SESSION_SECRET: "CHANGE_ME_LONG_RANDOM_SECRET"
  aws:elasticbeanstalk:command:
    Timeout: "600"
    BatchSize: "100"
    BatchSizeType: "Percentage"
  aws:elasticbeanstalk:healthreporting:system:
    SystemType: enhanced
